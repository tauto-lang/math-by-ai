import std::Base
import "notation.taut"
import core::equality
import "monoid.taut"

pub(open) inductive CommMonoid(A: Type, op: (A, A) -> A, unit: A): Prop {
  Mk(
    monoid: Monoid(A, op, unit),
    comm: (a: A, b: A) -> alg!(`op, unit; a ⋆ b = b ⋆ a`)
  ): CommMonoid(A, op, unit)
}
pub theorem comm_monoid<A>(
  op: (A, A) -> A,
  unit: A,
  m: CommMonoid(A, op, unit)
): Monoid(A, op, unit) {
  match m: Monoid(A, op, unit) { Mk(base, comm) => base }
}
pub theorem commute<A>(
  op: (A, A) -> A,
  unit: A,
  m: CommMonoid(A, op, unit),
  a: A,
  b: A
): alg!(`op, unit; a ⋆ b = b ⋆ a`) {
  match m: alg!(`op, unit; a ⋆ b = b ⋆ a`) { Mk(base, comm) => comm(a, b) }
}
pub theorem left_commute<A>(
  op: (A, A) -> A,
  unit: A,
  m: CommMonoid(A, op, unit),
  a: A,
  b: A,
  c: A
): alg!(`op, unit; a ⋆ (b ⋆ c) = b ⋆ (a ⋆ c)`) {
  let base := comm_monoid(op, unit, m)
  calc alg!(`op, unit; a ⋆ (b ⋆ c)`) {
    = alg!(`op, unit; a ⋆ b ⋆ c`) from Eq::sym(assoc(op, unit, base, a, b, c))
    = alg!(`op, unit; b ⋆ a ⋆ c`) from Eq::congr(
      (x: A) => alg!(`op, unit; x ⋆ c`),
      commute(op, unit, m, a, b)
    )
    = alg!(`op, unit; b ⋆ (a ⋆ c)`) from assoc(op, unit, base, b, a, c)
  }
}
pub theorem interchange<A>(
  op: (A, A) -> A,
  unit: A,
  m: CommMonoid(A, op, unit),
  a: A,
  b: A,
  c: A,
  d: A
): alg!(`op, unit; a ⋆ b ⋆ (c ⋆ d) = a ⋆ c ⋆ (b ⋆ d)`) {
  let base := comm_monoid(op, unit, m)
  calc alg!(`op, unit; a ⋆ b ⋆ (c ⋆ d)`) {
    = alg!(`op, unit; a ⋆ (b ⋆ (c ⋆ d))`) from assoc(op, unit, base, a, b, alg!(`op, unit; c ⋆ d`))
    = alg!(`op, unit; a ⋆ (c ⋆ (b ⋆ d))`) from Eq::congr(
      (x: A) => alg!(`op, unit; a ⋆ x`),
      left_commute(op, unit, m, b, c, d)
    )
    = alg!(`op, unit; a ⋆ c ⋆ (b ⋆ d)`) from Eq::sym(
      assoc(op, unit, base, a, c, alg!(`op, unit; b ⋆ d`))
    )
  }
}

// Generated by adjacent swaps, compatible heads, and transitivity.
pub(open) inductive Permutation(A: Type): (List(A)) -> (List(A)) -> Prop {
  Empty: Permutation(A, Nil, Nil)
  Keep(
    x: A,
    xs: List(A),
    ys: List(A),
    p: Permutation(A, xs, ys)
  ): Permutation(A, Cons(x, xs), Cons(x, ys))
  Swap(x: A, y: A, xs: List(A)): Permutation(A, Cons(x, Cons(y, xs)), Cons(y, Cons(x, xs)))
  Chain(
    xs: List(A),
    ys: List(A),
    zs: List(A),
    p: Permutation(A, xs, ys),
    q: Permutation(A, ys, zs)
  ): Permutation(A, xs, zs)
}
pub theorem product_permutation<A>(
  op: (A, A) -> A,
  unit: A,
  m: CommMonoid(A, op, unit),
  xs: List(A),
  ys: List(A),
  p: Permutation(A, xs, ys)
): alg!(`op, unit; product(op, ε, xs) = product(op, ε, ys)`) {
  match p: alg!(`op, unit; product(op, ε, xs) = product(op, ε, ys)`) {
    Empty => Refl
    Keep(x, as, bs, h) => Eq::congr(
      (v: A) => alg!(`op, unit; x ⋆ v`),
      product_permutation(op, unit, m, as, bs, h)
    )
    Swap(x, y, rest) => left_commute(op, unit, m, x, y, product(op, unit, rest))
    Chain(as, bs, cs, p2, q2) => calc alg!(`op, unit; product(op, ε, as)`) {
      = alg!(`op, unit; product(op, ε, bs)`) from product_permutation(op, unit, m, as, bs, p2)
      = alg!(`op, unit; product(op, ε, cs)`) from product_permutation(op, unit, m, bs, cs, q2)
    }
  }
}
pub theorem power_product<A>(
  op: (A, A) -> A,
  unit: A,
  m: CommMonoid(A, op, unit),
  a: A,
  b: A,
  n: Nat
): alg!(`op, unit; power(op, ε, a ⋆ b, n) = power(op, ε, a, n) ⋆ power(op, ε, b, n)`) {
  let base := comm_monoid(op, unit, m)
  match n: alg!(`op, unit; power(op, ε, a ⋆ b, n) = power(op, ε, a, n) ⋆ power(op, ε, b, n)`) {
    Zero => Eq::sym(left_unit(op, unit, base, unit))
    Succ(k) => calc alg!(`op, unit; power(op, ε, a ⋆ b, k) ⋆ (a ⋆ b)`) {
      = alg!(`op, unit; (power(op, ε, a, k) ⋆ power(op, ε, b, k)) ⋆ (a ⋆ b)`) from Eq::congr(
        (x: A) => alg!(`op, unit; x ⋆ (a ⋆ b)`),
        power_product(op, unit, m, a, b, k)
      )
      = alg!(`op, unit; power(op, ε, a, k) ⋆ a ⋆ (power(op, ε, b, k) ⋆ b)`) from interchange(
        op,
        unit,
        m,
        power(op, unit, a, k),
        power(op, unit, b, k),
        a,
        b
      )
    }
  }
}

pub theorem permutation_refl<A>(xs: List(A)): Permutation(A, xs, xs) {
  match xs: Permutation(A, xs, xs) {
    Nil => Empty
    Cons(x, rest) => Keep(x, rest, rest, permutation_refl(rest))
  }
}
pub theorem permutation_sym<A>(
  xs: List(A),
  ys: List(A),
  p: Permutation(A, xs, ys)
): Permutation(A, ys, xs) {
  match p: Permutation(A, ys, xs) {
    Empty => Empty
    Keep(x, as, bs, h) => Keep(x, bs, as, permutation_sym(as, bs, h))
    Swap(x, y, rest) => Swap(y, x, rest)
    Chain(as, bs, cs, h, k) => Chain(
      cs,
      bs,
      as,
      permutation_sym(bs, cs, k),
      permutation_sym(as, bs, h)
    )
  }
}
