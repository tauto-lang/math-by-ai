import std::Base
import "semiring_notation.taut"
import "monoid.taut"
import "commutative.taut"

// Multiplication need not commute (e.g. matrices).
pub(open) inductive Semiring(A: Type, add: (A, A) -> A, zero: A, mul: (A, A) -> A, one: A): Prop {
  Mk(
    additive: CommMonoid(A, add, zero),
    multiplicative: Monoid(A, mul, one),
    distrib_left: (
      a: A,
      b: A,
      c: A
    ) -> semiring!(`add, zero, mul, one; a * (b + c) = a * b + a * c`),
    distrib_right: (
      a: A,
      b: A,
      c: A
    ) -> semiring!(`add, zero, mul, one; (a + b) * c = a * c + b * c`),
    zero_left: (a: A) -> semiring!(`add, zero, mul, one; 0 * a = 0`),
    zero_right: (a: A) -> semiring!(`add, zero, mul, one; a * 0 = 0`)
  ): Semiring(A, add, zero, mul, one)
}
pub theorem semiring_additive<A>(
  add: (A, A) -> A,
  zero: A,
  mul: (A, A) -> A,
  one: A,
  s: Semiring(A, add, zero, mul, one)
): CommMonoid(A, add, zero) {
  match s: CommMonoid(A, add, zero) { Mk(a, m, l, r, zl, zr) => a }
}
pub theorem semiring_multiplicative<A>(
  add: (A, A) -> A,
  zero: A,
  mul: (A, A) -> A,
  one: A,
  s: Semiring(A, add, zero, mul, one)
): Monoid(A, mul, one) {
  match s: Monoid(A, mul, one) { Mk(a, m, l, r, zl, zr) => m }
}
pub theorem distribute_left<A>(
  add: (A, A) -> A,
  zero: A,
  mul: (A, A) -> A,
  one: A,
  s: Semiring(A, add, zero, mul, one),
  a: A,
  b: A,
  c: A
): semiring!(`add, zero, mul, one; a * (b + c) = a * b + a * c`) {
  match s: semiring!(
    `add, zero, mul, one; a * (b + c) = a * b + a * c`
  ) { Mk(am, mm, l, r, zl, zr) => l(a, b, c) }
}
pub theorem distribute_right<A>(
  add: (A, A) -> A,
  zero: A,
  mul: (A, A) -> A,
  one: A,
  s: Semiring(A, add, zero, mul, one),
  a: A,
  b: A,
  c: A
): semiring!(`add, zero, mul, one; (a + b) * c = a * c + b * c`) {
  match s: semiring!(
    `add, zero, mul, one; (a + b) * c = a * c + b * c`
  ) { Mk(am, mm, l, r, zl, zr) => r(a, b, c) }
}
pub theorem annihilate_left<A>(
  add: (A, A) -> A,
  zero: A,
  mul: (A, A) -> A,
  one: A,
  s: Semiring(A, add, zero, mul, one),
  a: A
): semiring!(`add, zero, mul, one; 0 * a = 0`) {
  match s: semiring!(`add, zero, mul, one; 0 * a = 0`) { Mk(am, mm, l, r, zl, zr) => zl(a) }
}
pub theorem annihilate_right<A>(
  add: (A, A) -> A,
  zero: A,
  mul: (A, A) -> A,
  one: A,
  s: Semiring(A, add, zero, mul, one),
  a: A
): semiring!(`add, zero, mul, one; a * 0 = 0`) {
  match s: semiring!(`add, zero, mul, one; a * 0 = 0`) { Mk(am, mm, l, r, zl, zr) => zr(a) }
}
pub theorem mul_sum_left<A>(
  add: (A, A) -> A,
  zero: A,
  mul: (A, A) -> A,
  one: A,
  s: Semiring(A, add, zero, mul, one),
  a: A,
  xs: List(A)
): semiring!(
  `add, zero, mul, one; a * product(add, 0, xs)`
) = product(add, zero, map_list((x: A) => semiring!(`add, zero, mul, one; a * x`), xs)) {
  map_product(
    add,
    zero,
    add,
    zero,
    (x: A) => semiring!(`add, zero, mul, one; a * x`),
    annihilate_right(add, zero, mul, one, s, a),
    (x: A, y: A) => distribute_left(add, zero, mul, one, s, a, x, y),
    xs
  )
}
pub theorem mul_sum_right<A>(
  add: (A, A) -> A,
  zero: A,
  mul: (A, A) -> A,
  one: A,
  s: Semiring(A, add, zero, mul, one),
  a: A,
  xs: List(A)
): semiring!(
  `add, zero, mul, one; product(add, 0, xs) * a`
) = product(add, zero, map_list((x: A) => semiring!(`add, zero, mul, one; x * a`), xs)) {
  map_product(
    add,
    zero,
    add,
    zero,
    (x: A) => semiring!(`add, zero, mul, one; x * a`),
    annihilate_left(add, zero, mul, one, s, a),
    (x: A, y: A) => distribute_right(add, zero, mul, one, s, x, y, a),
    xs
  )
}
// Four terms in row order: valid even when multiplication is noncommutative.
pub theorem expand_product<A>(
  add: (A, A) -> A,
  zero: A,
  mul: (A, A) -> A,
  one: A,
  s: Semiring(A, add, zero, mul, one),
  a: A,
  b: A,
  c: A,
  d: A
): semiring!(`add, zero, mul, one; (a + b) * (c + d) = a * c + a * d + (b * c + b * d)`) {
  calc semiring!(`add, zero, mul, one; (a + b) * (c + d)`) {
    = semiring!(`add, zero, mul, one; a * (c + d) + b * (c + d)`) from distribute_right(
      add,
      zero,
      mul,
      one,
      s,
      a,
      b,
      semiring!(`add, zero, mul, one; c + d`)
    )
    = semiring!(`add, zero, mul, one; a * c + a * d + b * (c + d)`) from Eq::congr(
      (v: A) => semiring!(`add, zero, mul, one; v + b * (c + d)`),
      distribute_left(add, zero, mul, one, s, a, c, d)
    )
    = semiring!(`add, zero, mul, one; a * c + a * d + (b * c + b * d)`) from Eq::congr(
      (v: A) => semiring!(`add, zero, mul, one; a * c + a * d + v`),
      distribute_left(add, zero, mul, one, s, b, c, d)
    )
  }
}
