import std::Calc { calc }
import std::Base
import "notation.taut"
import core::equality
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_case, proof_we }

// The operation is a parameter: one carrier can have several monoids.
pub(open) inductive Monoid(A: Type, op: (A, A) -> A, unit: A): Prop {
  Mk(
    assoc: (a: A, b: A, c: A) -> alg!(`op, unit; a ⋆ b ⋆ c = a ⋆ (b ⋆ c)`),
    left_unit: (a: A) -> alg!(`op, unit; ε ⋆ a = a`),
    right_unit: (a: A) -> alg!(`op, unit; a ⋆ ε = a`)
  ): Monoid(A, op, unit)
}

pub theorem assoc<A>(
  op: (A, A) -> A,
  unit: A,
  m: Monoid(A, op, unit),
  a: A,
  b: A,
  c: A
): alg!(`op, unit; a ⋆ b ⋆ c = a ⋆ (b ⋆ c)`) {
  ⊢ alg!(`op, unit; a ⋆ b ⋆ c = a ⋆ (b ⋆ c)`) from match m {
    Mk(h, l, r) => h(a, b, c)
  }
}
pub theorem left_unit<A>(
  op: (A, A) -> A,
  unit: A,
  m: Monoid(A, op, unit),
  a: A
): alg!(`op, unit; ε ⋆ a = a`) {
  ⊢ alg!(`op, unit; ε ⋆ a = a`) from match m { Mk(h, l, r) => l(a) }
}
pub theorem right_unit<A>(
  op: (A, A) -> A,
  unit: A,
  m: Monoid(A, op, unit),
  a: A
): alg!(`op, unit; a ⋆ ε = a`) {
  ⊢ alg!(`op, unit; a ⋆ ε = a`) from match m { Mk(h, l, r) => r(a) }
}

pub fn product<A>(op: (A, A) -> A, unit: A, xs: List(A)): A {
  ⊢ A from match xs { Nil => unit
    Cons(x, rest) => alg!(`op, unit; x ⋆ product(op, ε, rest)`) }
}

pub theorem product_append<A>(
  op: (A, A) -> A,
  unit: A,
  m: Monoid(A, op, unit),
  xs: List(A),
  ys: List(A)
): alg!(`op, unit; product(op, ε, List::append(xs, ys)) = product(op, ε, xs) ⋆ product(op, ε, ys)`) {
  proof!(```
      By induction on xs.
        [base] Case Nil. By Eq::sym.
        Case Cons(x, rest). We have $alg!(`op, unit; x ⋆ product(op, ε, List::append(rest, ys))`)
        = $alg!(`op, unit; x ⋆ (product(op, ε, rest) ⋆ product(op, ε, ys))`) by the induction hypothesis
        = $alg!(`op, unit; x ⋆ product(op, ε, rest) ⋆ product(op, ε, ys)`) by assoc(op, unit, m, x, product(op, unit, rest), product(op, unit, ys)).
      %%
      [base] left_unit(op, unit, m, product(op, unit, ys))
    ```)
}

pub theorem unit_unique<A>(
  op: (A, A) -> A,
  unit: A,
  m: Monoid(A, op, unit),
  other: A,
  other_left: (a: A) -> alg!(`op, unit; other ⋆ a = a`)
): other = unit {
  calc!(```
    $other
    = $alg!(`op, unit; other ⋆ ε`) from $Eq::sym(right_unit(op, unit, m, other))
    = $unit from $other_left(unit)
    ```)
}

pub fn power<A>(op: (A, A) -> A, unit: A, a: A, n: Nat): A {
  ⊢ A from match n {
    Zero => unit
    Succ(k) => op(power(op, unit, a, k), a)
  }
}

pub theorem power_add<A>(
  op: (A, A) -> A,
  unit: A,
  m: Monoid(A, op, unit),
  a: A,
  n: Nat,
  k: Nat
): alg!(`op, unit; power(op, ε, a, $(n + k)) = power(op, ε, a, n) ⋆ power(op, ε, a, k)`) {
  proof!(```
      By induction on k.
        [base] Case Zero. By Eq::sym.
        Case Succ(j). We have $alg!(`op, unit; power(op, ε, a, $(n + j)) ⋆ a`)
        = $alg!(`op, unit; (power(op, ε, a, n) ⋆ power(op, ε, a, j)) ⋆ a`) by the induction hypothesis
        = $alg!(`op, unit; power(op, ε, a, n) ⋆ (power(op, ε, a, j) ⋆ a)`) by assoc(op, unit, m, power(op, unit, a, n), power(op, unit, a, j), a).
      %%
      [base] right_unit(op, unit, m, power(op, unit, a, n))
    ```)
}

// A map preserving the operation and unit preserves every finite product.
pub fn map_list<A, B>(f: (A) -> B, xs: List(A)): List(B) {
  ⊢ List(B) from match xs {
    Nil => Nil
    Cons(x, rest) => Cons(f(x), map_list(f, rest))
  }
}

pub theorem map_product<A, B>(
  op: (A, A) -> A,
  unit: A,
  target: (B, B) -> B,
  target_unit: B,
  f: (A) -> B,
  preserves_unit: f(unit) = target_unit,
  preserves_op: (
    a: A,
    b: A
  ) -> f(alg!(`op, unit; a ⋆ b`)) = alg!(`target, target_unit; f(a) ⋆ f(b)`),
  xs: List(A)
): f(product(op, unit, xs)) = product(target, target_unit, map_list(f, xs)) {
  proof!(```
      By induction on xs.
        Case Nil. By preserves_unit.
        Case Cons(x, rest). We have $f(alg!(`op, unit; x ⋆ product(op, ε, rest)`))
        = $alg!(`target, target_unit; f(x) ⋆ f(product(op, unit, rest))`) by preserves_op(x, product(op, unit, rest))
        = $alg!(`target, target_unit; f(x) ⋆ product(target, ε, map_list(f, rest))`) by the induction hypothesis.
    ```)
}

pub theorem product_cons_congr<A>(
  op: (A, A) -> A,
  unit: A,
  a: A,
  b: A,
  xs: List(A),
  ys: List(A),
  heads: a = b,
  tails: alg!(`op, unit; product(op, ε, xs) = product(op, ε, ys)`)
): alg!(`op, unit; product(op, ε, Cons(a, xs)) = product(op, ε, Cons(b, ys))`) {
  congr2(op, a, b, product(op, unit, xs), product(op, unit, ys), heads, tails)
}
