import std::Calc { calc }
import std::Base
import "notation.taut"
import core::notation
import "monoid.taut"
import std::proof::Lang { proof }
import std::proof::Forms { proof_by, proof_we }

// No commutativity assumption: all theorems apply to nonabelian groups.
pub(open) inductive Group(A: Type, op: (A, A) -> A, unit: A, inv: (A) -> A): Prop {
  Mk(
    monoid: Monoid(A, op, unit),
    left_inverse: (a: A) -> alg!(`op, unit; inv(a) ⋆ a = ε`),
    right_inverse: (a: A) -> alg!(`op, unit; a ⋆ inv(a) = ε`)
  ): Group(A, op, unit, inv)
}
pub theorem group_monoid<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv)
): Monoid(A, op, unit) {
  ⊢ Monoid(A, op, unit) from match g { Mk(m, l, r) => m }
}
pub theorem inverse_left<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv),
  a: A
): alg!(`op, unit; inv(a) ⋆ a = ε`) {
  ⊢ alg!(`op, unit; inv(a) ⋆ a = ε`) from match g { Mk(m, l, r) => l(a) }
}
pub theorem inverse_right<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv),
  a: A
): alg!(`op, unit; a ⋆ inv(a) = ε`) {
  ⊢ alg!(`op, unit; a ⋆ inv(a) = ε`) from match g { Mk(m, l, r) => r(a) }
}
pub theorem undo_left<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv),
  a: A,
  b: A
): alg!(`op, unit; inv(a) ⋆ (a ⋆ b) = b`) {
  let m := group_monoid(op, unit, inv, g)
  calc!(```
    $alg!(`op, unit; inv(a) ⋆ (a ⋆ b)`)
    = $alg!(`op, unit; inv(a) ⋆ a ⋆ b`) from $Eq::sym(assoc(op, unit, m, inv(a), a, b))
    = $alg!(`op, unit; ε ⋆ b`) from $Eq::congr(
      (x: A) => alg!(`op, unit; x ⋆ b`),
      inverse_left(op, unit, inv, g, a)
    )
    = $b from $left_unit(op, unit, m, b)
    ```)
}
pub theorem undo_right<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv),
  a: A,
  b: A
): alg!(`op, unit; b ⋆ a ⋆ inv(a) = b`) {
  let m := group_monoid(op, unit, inv, g)
  calc!(```
    $alg!(`op, unit; b ⋆ a ⋆ inv(a)`)
    = $alg!(`op, unit; b ⋆ (a ⋆ inv(a))`) from $assoc(op, unit, m, b, a, inv(a))
    = $alg!(`op, unit; b ⋆ ε`) from $Eq::congr(
      (x: A) => alg!(`op, unit; b ⋆ x`),
      inverse_right(op, unit, inv, g, a)
    )
    = $b from $right_unit(op, unit, m, b)
    ```)
}
pub theorem cancel_left<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv),
  a: A,
  b: A,
  c: A,
  h: alg!(`op, unit; a ⋆ b = a ⋆ c`)
): b = c {
  proof!(```
      [1] We have b
        = $alg!(`op, unit; inv(a) ⋆ (a ⋆ b)`) by undo_left(op, unit, inv, g, a, b)
        = $alg!(`op, unit; inv(a) ⋆ (a ⋆ c)`) by h
        = c by undo_left(op, unit, inv, g, a, c).
    ```)
}
pub theorem cancel_right<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv),
  a: A,
  b: A,
  c: A,
  h: alg!(`op, unit; b ⋆ a = c ⋆ a`)
): b = c {
  proof!(```
      [1] We have b
        = $alg!(`op, unit; b ⋆ a ⋆ inv(a)`) by undo_right(op, unit, inv, g, a, b)
        = $alg!(`op, unit; c ⋆ a ⋆ inv(a)`) by h
        = c by undo_right(op, unit, inv, g, a, c).
    ```)
}
pub theorem inverse_unique<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv),
  a: A,
  b: A,
  h: alg!(`op, unit; a ⋆ b = ε`)
): b = inv(a) {
  proof!(```
      [1] We have k: $alg!(`op, unit; a ⋆ b`)
        = $alg!(`op, unit; ε`) by h
        = $alg!(`op, unit; a ⋆ inv(a)`) by inverse_right(op, unit, inv, g, a). By cancel_left(op, unit, inv, g, a, b, inv(a), k).
    ```)
}
pub theorem inverse_involution<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv),
  a: A
): logic!(`inv(inv(a)) = a`) {
  proof!(```
      [1] By Eq::sym.
      %%
      [1] inverse_unique(op, unit, inv, g, inv(a), a, inverse_left(op, unit, inv, g, a))
    ```)
}
pub theorem inverse_unit<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv)
): logic!(`inv(unit) = unit`) {
  proof!(```
      [1] By Eq::sym.
      %%
      [1] inverse_unique(op, unit, inv, g, unit, unit, left_unit(op, unit, group_monoid(op, unit, inv, g), unit))
    ```)
}
pub theorem inverse_product<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv),
  a: A,
  b: A
): alg!(`op, unit; inv(a ⋆ b) = inv(b) ⋆ inv(a)`) {
  proof!(```
      [main] We have h: $alg!(`op, unit; (a ⋆ b) ⋆ (inv(b) ⋆ inv(a))`)
        = $alg!(`op, unit; a ⋆ b ⋆ inv(b) ⋆ inv(a)`) by assoc(op, unit, group_monoid(op, unit, inv, g), op(a, b), inv(b), inv(a))
        = $alg!(`op, unit; a ⋆ inv(a)`) by undo_right(op, unit, inv, g, b, a)
        = $alg!(`op, unit; ε`) by inverse_right(op, unit, inv, g, a). By Eq::sym.
      %%
      [main] inverse_unique(op, unit, inv, g, op(a, b), op(inv(b), inv(a)), h)
    ```)
}

pub theorem solve_left<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv),
  a: A,
  b: A
): alg!(`op, unit; a ⋆ (inv(a) ⋆ b) = b`) {
  proof!(```
      [1] We have $alg!(`op, unit; a ⋆ (inv(a) ⋆ b)`)
        = $alg!(`op, unit; a ⋆ inv(a) ⋆ b`) by assoc(op, unit, group_monoid(op, unit, inv, g), a, inv(a), b)
        = $alg!(`op, unit; ε ⋆ b`) by inverse_right(op, unit, inv, g, a)
        = b by left_unit(op, unit, group_monoid(op, unit, inv, g), b).
    ```)
}
pub theorem solution_unique<A>(
  op: (A, A) -> A,
  unit: A,
  inv: (A) -> A,
  g: Group(A, op, unit, inv),
  a: A,
  b: A,
  x: A,
  h: alg!(`op, unit; a ⋆ x = b`)
): alg!(`op, unit; x = inv(a) ⋆ b`) {
  proof!(```
      [1] We have x
        = $alg!(`op, unit; inv(a) ⋆ (a ⋆ x)`) by undo_left(op, unit, inv, g, a, x)
        = $alg!(`op, unit; inv(a) ⋆ b`) by h.
    ```)
}
