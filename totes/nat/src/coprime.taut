import std::Calc { calc }
import std::Base
import std::Nat
import std::NatNorm
import std::Tactic
import "notation.taut"
import "relations.taut"
import "divisibility.taut"
import "subtraction.taut"
import "euclid.taut"
import "bezout.taut"

pub fn Coprime(a: Nat, b: Nat): Prop { nat!(`gcd(a, b) = 1`) }

theorem scale_left(
  a: Nat,
  b: Nat,
  g: Nat,
  c: Nat,
  na: Nat,
  nb: Nat
): nat!(`(g + (a * na + b * nb)) * c = g * c + (a * c * na + b * c * nb)`) {
  by nat_norm!(): nat!(`(g + (a * na + b * nb)) * c = g * c + (a * c * na + b * c * nb)`) {}
}
theorem scale_right(
  a: Nat,
  b: Nat,
  c: Nat,
  pa: Nat,
  pb: Nat
): nat!(`(a * pa + b * pb) * c = a * c * pa + b * c * pb`) {
  by nat_norm!(): nat!(`(a * pa + b * pb) * c = a * c * pa + b * c * pb`) {}
}
pub theorem balance_scaled(
  a: Nat,
  b: Nat,
  g: Nat,
  c: Nat,
  coeff: Coefficients,
  h: balance(a, b, g, coeff)
): balance(nat!(`a * c`), nat!(`b * c`), nat!(`g * c`), coeff) {
  ⊢ balance(nat!(`a * c`), nat!(`b * c`), nat!(`g * c`), coeff) from match coeff {
    Coeff(pa, na, pb, nb) => calc!(```
      $nat!(`g * c + (a * c * na + b * c * nb)`)
      = $nat!(`(g + (a * na + b * nb)) * c`) from $Eq::sym(scale_left(a, b, g, c, na, nb))
      = $nat!(`(a * pa + b * pb) * c`) from $Eq::congr((x: Nat) => nat!(`x * c`), h)
      = $nat!(`a * c * pa + b * c * pb`) from $scale_right(a, b, c, pa, pb)
      ```)
  }
}
// A common divisor of a and b divides the balanced value g.
pub theorem divides_balance(
  a: Nat,
  b: Nat,
  g: Nat,
  coeff: Coefficients,
  h: balance(a, b, g, coeff),
  d: Nat,
  da: nat_rel!(`d | a`),
  db: nat_rel!(`d | b`)
): nat_rel!(`d | g`) {
  ⊢ nat_rel!(`d | g`) from match coeff {
    Coeff(pa, na, pb, nb) => Eq::subst(
      (x: Nat) => nat_rel!(`d | x`),
      calc!(```
        $nat!(`(a * pa + b * pb) - (a * na + b * nb)`)
        = $nat!(`(g + (a * na + b * nb)) - (a * na + b * nb)`) from $Eq::congr(
          (x: Nat) => nat!(`x - (a * na + b * nb)`),
          Eq::sym(h)
        )
        = $nat!(`((a * na + b * nb) + g) - (a * na + b * nb)`) from $Eq::congr(
          (x: Nat) => nat!(`x - (a * na + b * nb)`),
          Nat::add_comm(g, nat!(`a * na + b * nb`))
        )
        = $g from $sub_sum_left(nat!(`a * na + b * nb`), g)
        ```),
      divides_subtract(
        d,
        nat!(`a * pa + b * pb`),
        nat!(`a * na + b * nb`),
        divides_add(
          d,
          nat!(`a * pa`),
          nat!(`b * pb`),
          divides_mul_right(d, a, pa, da),
          divides_mul_right(d, b, pb, db)
        ),
        divides_add(
          d,
          nat!(`a * na`),
          nat!(`b * nb`),
          divides_mul_right(d, a, na, da),
          divides_mul_right(d, b, nb, db)
        )
      )
    )
  }
}
pub theorem coprime_common_multiple(
  a: Nat,
  b: Nat,
  c: Nat,
  d: Nat,
  h: Coprime(a, b),
  da: nat_rel!(`d | a * c`),
  db: nat_rel!(`d | b * c`)
): nat_rel!(`d | c`) {
  Eq::subst(
    (x: Nat) => nat_rel!(`d | x`),
    calc!(```
      $nat!(`gcd(a, b) * c`)
      = $nat!(`1 * c`) from $Eq::congr((x: Nat) => nat!(`x * c`), h)
      = $c from $Nat::mul_one_left(c)
      ```),
    divides_balance(
      nat!(`a * c`),
      nat!(`b * c`),
      nat!(`gcd(a, b) * c`),
      bezout_coefficients(a, b),
      balance_scaled(a, b, gcd(a, b), c, bezout_coefficients(a, b), bezout_balance(a, b)),
      d,
      da,
      db
    )
  )
}
// Euclid's lemma for arbitrary coprime natural numbers.
pub theorem coprime_cancel(
  a: Nat,
  b: Nat,
  c: Nat,
  h: Coprime(a, b),
  divides_product: nat_rel!(`a | b * c`)
): nat_rel!(`a | c`) {
  coprime_common_multiple(
    a,
    b,
    c,
    a,
    h,
    divides_mul_right(a, a, c, divides_refl(a)),
    divides_product
  )
}
