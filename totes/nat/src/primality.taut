import std::Calc { calc }
import std::Base
import std::Nat
import std::NatDiv
import std::NatNorm
import std::IntLaws
import "notation.taut"
import "relations.taut"
import core::notation
import "divisibility.taut"
import "primes.taut"

pub theorem divides_remainder_zero(
  n: Nat,
  k: Nat,
  h: nat_rel!(`Succ(k) | n`)
): nat!(`Nat::rem_nz(n, Succ(k), Nat::succ_ne_zero(k)) = 0`) {
  ⊢ nat!(`Nat::rem_nz(n, Succ(k), Nat::succ_ne_zero(k)) = 0`) from match h {
    By(q, eq) => Eq::subst(
      (x: Nat) => nat!(`Nat::rem_nz(x, Succ(k), Nat::succ_ne_zero(k)) = 0`),
      eq,
      Nat::mod_of(q, 0, k, Refl)
    )
  }
}
pub fn bool_neg(b: Bool): Bool { ⊢ Bool from match b { false => true, true => false } }
pub fn divisor_test(n: Nat, d: Nat): Bool {
  ⊢ Bool from match d {
    Zero => true
    Succ(k) => ⊢ Bool from match k {
      Zero => true
      Succ(j) => Bool::or(
        Nat::eq(d, n),
        bool_neg(Nat::eq(Nat::rem_nz(n, d, Nat::succ_ne_zero(k)), 0))
      )
    }
  }
}
pub fn trial(n: Nat, bound: Nat): Bool {
  ⊢ Bool from match bound {
    Zero => true
    Succ(k) => Bool::and(trial(n, k), divisor_test(n, Succ(k)))
  }
}
pub fn is_prime(n: Nat): Bool { Bool::and(Nat::lt(1, n), trial(n, n)) }

pub theorem boolean_cases(b: Bool): logic!(`b = false ∨ b = true`) {
  ⊢ logic!(`b = false ∨ b = true`) from match b { false => OrInl(Refl)
    true => OrInr(Refl) }
}
theorem divisor_test_with_rem(
  n: Nat,
  k: Nat,
  eq: Nat::eq(Succ(Succ(k)), n) = false,
  rem: Nat::rem_nz(n, Succ(Succ(k)), Nat::succ_ne_zero(Succ(k))) = 0
): divisor_test(n, Succ(Succ(k))) = false {
  Eq::trans(
    Eq::congr(
      (e: Bool) => Bool::or(
        e,
        bool_neg(Nat::eq(Nat::rem_nz(n, Succ(Succ(k)), Nat::succ_ne_zero(Succ(k))), 0))
      ),
      eq
    ),
    Eq::congr((r: Nat) => bool_neg(Nat::eq(r, 0)), rem)
  )
}
pub theorem divisor_test_sound(
  n: Nat,
  d: Nat,
  pos: nat!(`1 < n`),
  good: divisor_test(n, d) = true,
  divides: nat_rel!(`d | n`)
): logic!(`d = 1 ∨ d = n`) {
  ⊢ logic!(`d = 1 ∨ d = n`) from match d {
    Zero => False::elim(
      false_ne_true(
        Eq::trans(
          Eq::sym(Eq::congr((x: Nat) => Nat::lt(1, x), zero_divides_only_zero(n, divides))),
          pos
        )
      )
    )
    Succ(k) => ⊢ logic!(`Succ(k) = 1 ∨ Succ(k) = n`) from match k {
      Zero => OrInl(Refl)
      Succ(j) => Or::elim(
        boolean_cases(Nat::eq(Succ(Succ(j)), n)),
        (ne: Nat::eq(Succ(Succ(j)), n) = false) => False::elim(
          false_ne_true(
            Eq::trans(
              Eq::sym(divisor_test_with_rem(n, j, ne, divides_remainder_zero(n, Succ(j), divides))),
              good
            )
          )
        ),
        (eq: Nat::eq(Succ(Succ(j)), n) = true) => OrInr(Nat::eq_sound(Succ(Succ(j)), n, eq))
      )
    }
  }
}
theorem range_sound(
  n: Nat,
  bound: Nat,
  pos: nat!(`1 < n`),
  good: trial(n, bound) = true,
  d: Nat,
  le: nat!(`d ≤ bound`),
  divides: nat_rel!(`d | n`)
): logic!(`d = 1 ∨ d = n`) {
  ⊢ logic!(`d = 1 ∨ d = n`) from match bound {
    Zero => ⊢ logic!(`d = 1 ∨ d = n`) from match d {
      Zero => divisor_test_sound(n, 0, pos, Refl, divides)
      Succ(k) => False::elim(false_ne_true(Eq::trans(Eq::sym(Nat::lt_zero_false(k)), le)))
    }
    Succ(k) => Or::elim(
      boolean_cases(Nat::eq(d, Succ(k))),
      (ne: Nat::eq(d, Succ(k)) = false) => range_sound(
        n,
        k,
        pos,
        Bool::and_true_left(trial(n, k), divisor_test(n, Succ(k)), good),
        d,
        Nat::lt_succ_ne(d, Succ(k), le, ne),
        divides
      ),
      (eq: Nat::eq(d, Succ(k)) = true) => divisor_test_sound(
        n,
        d,
        pos,
        Eq::subst(
          (x: Nat) => divisor_test(n, x) = true,
          Eq::sym(Nat::eq_sound(d, Succ(k), eq)),
          Bool::and_true_right(trial(n, k), divisor_test(n, Succ(k)), good)
        ),
        divides
      )
    )
  }
}
pub theorem is_prime_sound(n: Nat, good: is_prime(n) = true): Prime(n) {
  PrimeBy(Bool::and_true_left(Nat::lt(1, n), trial(n, n), good),
    (d: Nat, h: nat_rel!(`d | n`)) => range_sound(n, n,
      Bool::and_true_left(Nat::lt(1, n), trial(n, n), good),
      Bool::and_true_right(Nat::lt(1, n), trial(n, n), good), d,
      ⊢ nat!(`d ≤ n`) from match n {
        Zero => False::elim(false_ne_true(Bool::and_true_left(Nat::lt(1, 0), trial(0, 0), good)))
        Succ(k) => divides_bound(d, k, h)
      }, h))
}

pub fn find_factor(n: Nat, bound: Nat): Nat {
  ⊢ Nat from match bound {
    Zero => 0
    Succ(k) => if divisor_test(n, Succ(k)) { find_factor(n, k) } else { Succ(k) }
  }
}
pub(open) inductive BadCandidate(n: Nat, bound: Nat, d: Nat): Prop {
  Candidate(bad: divisor_test(n, d) = false, within: nat!(`d ≤ bound`)): BadCandidate(n, bound, d)
}
pub theorem candidate_bad(
  n: Nat,
  bound: Nat,
  d: Nat,
  h: BadCandidate(n, bound, d)
): divisor_test(n, d) = false {
  ⊢ divisor_test(n, d) = false from match h { Candidate(bad, within) => bad }
}
pub theorem candidate_bound(
  n: Nat,
  bound: Nat,
  d: Nat,
  h: BadCandidate(n, bound, d)
): nat!(`d ≤ bound`) {
  ⊢ nat!(`d ≤ bound`) from match h { Candidate(bad, within) => within }
}
theorem and_true_identity(a: Bool): Bool::and(a, true) = a {
  ⊢ Bool::and(a, true) = a from match a { false => Refl, true => Refl }
}
theorem and_with_true(a: Bool, b: Bool, hb: b = true, h: Bool::and(a, b) = false): a = false {
  calc!(```
    $a
    = $Bool::and(a, true) from $Eq::sym(and_true_identity(a))
    = $Bool::and(a, b) from $Eq::sym(Eq::congr((x: Bool) => Bool::and(a, x), hb))
    = $false from $h
    ```)
}
theorem find_true(
  n: Nat,
  k: Nat,
  good: divisor_test(n, Succ(k)) = true
): find_factor(n, Succ(k)) = find_factor(n, k) {
  Eq::congr((b: Bool) => if b { find_factor(n, k) } else { Succ(k) }, good)
}
theorem find_false(
  n: Nat,
  k: Nat,
  bad: divisor_test(n, Succ(k)) = false
): find_factor(n, Succ(k)) = Succ(k) {
  Eq::congr((b: Bool) => if b { find_factor(n, k) } else { Succ(k) }, bad)
}
pub theorem find_factor_correct(
  n: Nat,
  bound: Nat,
  bad: trial(n, bound) = false
): BadCandidate(n, bound, find_factor(n, bound)) {
  ⊢ BadCandidate(n, bound, find_factor(n, bound)) from match bound {
    Zero => False::elim(true_ne_false(bad))
    Succ(k) => Or::elim(
      boolean_cases(divisor_test(n, Succ(k))),
      (no: divisor_test(n, Succ(k)) = false) => Eq::subst(
        (d: Nat) => BadCandidate(n, Succ(k), d),
        Eq::sym(find_false(n, k, no)),
        Candidate(no, Nat::le_refl(Succ(k)))
      ),
      (yes: divisor_test(n, Succ(k)) = true) => Eq::subst(
        (d: Nat) => BadCandidate(n, Succ(k), d),
        Eq::sym(find_true(n, k, yes)),
        Candidate(
          candidate_bad(
            n,
            k,
            find_factor(n, k),
            find_factor_correct(
              n,
              k,
              and_with_true(trial(n, k), divisor_test(n, Succ(k)), yes, bad)
            )
          ),
          Nat::le_trans(
            find_factor(n, k),
            k,
            Succ(k),
            candidate_bound(
              n,
              k,
              find_factor(n, k),
              find_factor_correct(
                n,
                k,
                and_with_true(trial(n, k), divisor_test(n, Succ(k)), yes, bad)
              )
            ),
            Nat::le_succ(k)
          )
        )
      )
    )
  }
}
