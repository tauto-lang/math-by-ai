import std::Base
import std::Int
import std::IntOrder
import std::prelude::Macro
import core::highlight

pub fn int_tokens(ts: List(SynTok)): List(SynHighlight) ! {Div} { math_tokens(ts) }

syntax!(int_notation, ```par
%start Expr
%title "integer arithmetic"
%%
Expr: Sum [ Relation Sum ];
Relation: EqOp | LeOp | LtOp;
Sum: Prod { AddOp Prod };
AddOp: Plus | Minus;
Prod: Atom { Star Atom };
Atom: Num | Reference | Paren | Embed | Lift | Difference | Negative;
Negative: Minus Atom;
Lift: Up NatAtom;
Difference: Diff LParen NatSum Comma NatSum RParen;
NatSum: NatProd { NativeAddOp NatProd };
NativeAddOp: Plus | Minus;
NatProd: NatAtom { Star NatAtom };
NatAtom: Num | NativeReference | Embed | NativeParen;
NativeReference: Name [ NativeArguments ];
NativeArguments: LParen NatSum { Comma NatSum } RParen;
NativeParen: LParen NatSum RParen;
Up: '↑';
Diff: 'diff';
Reference: Name [ Arguments ];
Arguments: LParen Expr { Comma Expr } RParen;
Paren: LParen Expr RParen;
Embed: TautoExpr;
Name: /[_\p{L}][_\p{L}\p{N}']*(::[_\p{L}][_\p{L}\p{N}']*)*/;
Num: /[0-9]+/;
EqOp: '=';
LeOp: '≤';
LtOp: '<';
Plus: '+';
Minus: '-';
Star: '*';
Comma: ',';
LParen: '(';
RParen: ')';
```, with(tokens: int_tokens)) => struct Expr, struct Expr_Opt1, enum Relation,
  struct Sum, struct Sum_Rep1, enum AddOp, struct Prod, struct Prod_Rep1,
  enum Atom, struct Lift, struct Difference, struct Negative, enum NatAtom,
  struct NatSum, struct NatSum_Rep1, enum NativeAddOp, struct NatProd, struct NatProd_Rep1,
  struct NativeReference, struct NativeArguments, struct NativeArguments_Rep1, struct NativeParen, struct Reference, struct Arguments, struct Arguments_Rep1, struct Paren, fn parse

pub fn int_name(t: SynToken): SynExpr {
  ExVar(Syn::ident(t))
}
pub fn int_arguments(
  first: int_notation::Expr,
  rest: List(int_notation::Arguments_Rep1)
): List(SynExpr) ! {macro_error, Div} {
  Cons(int_expression(first), int_more_arguments(rest))
}
pub fn int_more_arguments(
  rest: List(int_notation::Arguments_Rep1)
): List(SynExpr) ! {macro_error, Div} {
  match rest { Nil => Nil
    Cons(r, more) => Cons(int_expression(r.expr), int_more_arguments(more)) }
}
pub fn int_atom(t: int_notation::Atom): SynExpr ! {macro_error, Div} {
  match t {
    Num(tok) => {
      let n := ExNat(tok.text, tok.span)
      quote { IntOfNat($n) }
    }
    Reference(r) => match r.arguments {
      None => int_name(r.name)
      Some(args) => ExApp(int_name(r.name), int_arguments(args.expr, args.rep), r.span)
    }
    Paren(p) => int_expression(p.expr)
    Embed(e) => e
    Negative(n) => { let x := int_atom(n.atom)
      quote { Int::neg($x) } }
    Lift(l) => { let n := int_nat_atom(l.nat_atom)
      quote { IntOfNat($n) } }
    Difference(d) => { let p := int_native_sum(d.nat_sum)
      let n := int_native_sum(d.nat_sum_2)
      quote { Int::sub_nat($p, $n) } }
  }
}
pub fn int_native_args(
  xs: List(int_notation::NativeArguments_Rep1)
): List(SynExpr) ! {macro_error, Div} {
  match xs { Nil => Nil
    Cons(x, rest) => Cons(int_native_sum(x.nat_sum), int_native_args(rest)) }
}
pub fn int_nat_atom(t: int_notation::NatAtom): SynExpr ! {macro_error, Div} {
  match t {
    Num(tok) => ExNat(tok.text, tok.span)
    Embed(e) => e
    NativeParen(p) => int_native_sum(p.nat_sum)
    NativeReference(r) => match r.native_arguments {
      None => int_name(r.name)
      Some(args) => ExApp(
        int_name(r.name),
        Cons(int_native_sum(args.nat_sum), int_native_args(args.rep)),
        r.span
      )
    }
  }
}
pub fn int_native_factors(
  acc: SynExpr,
  xs: List(int_notation::NatProd_Rep1)
): SynExpr ! {macro_error, Div} {
  match xs { Nil => acc
    Cons(x, rest) => { let b := int_nat_atom(x.nat_atom)
      int_native_factors(quote { Nat::mul($acc, $b) }, rest) }
  }
}
pub fn int_native_prod(p: int_notation::NatProd): SynExpr ! {macro_error, Div} {
  int_native_factors(int_nat_atom(p.nat_atom), p.rep)
}
pub fn int_native_summands(
  acc: SynExpr,
  xs: List(int_notation::NatSum_Rep1)
): SynExpr ! {macro_error, Div} {
  match xs { Nil => acc
    Cons(x, rest) => { let b := int_native_prod(x.nat_prod)
      let next := match x.native_add_op { Plus(t) => quote { Nat::add($acc, $b) }
        Minus(t) => quote { Nat::sub($acc, $b) } }
      int_native_summands(next, rest) }
  }
}
pub fn int_native_sum(s: int_notation::NatSum): SynExpr ! {macro_error, Div} {
  int_native_summands(int_native_prod(s.nat_prod), s.rep)
}
pub fn int_factors(
  acc: SynExpr,
  rest: List(int_notation::Prod_Rep1)
): SynExpr ! {macro_error, Div} {
  match rest { Nil => acc
    Cons(r, more) => {
      let t := int_atom(r.atom)
      int_factors(quote { Int::mul($acc, $t) }, more)
    }
  }
}
pub fn int_product(p: int_notation::Prod): SynExpr ! {macro_error, Div} {
  int_factors(int_atom(p.atom), p.rep)
}
pub fn int_summands(
  acc: SynExpr,
  rest: List(int_notation::Sum_Rep1)
): SynExpr ! {macro_error, Div} {
  match rest { Nil => acc
    Cons(r, more) => {
      let t := int_product(r.prod)
      let next := match r.add_op {
        Plus(tok) => quote { Int::add($acc, $t) }
        Minus(tok) => quote { Int::sub($acc, $t) }
      }
      int_summands(next, more)
    }
  }
}
pub fn int_sum(s: int_notation::Sum): SynExpr ! {macro_error, Div} {
  int_summands(int_product(s.prod), s.rep)
}
pub fn int_expression(e: int_notation::Expr): SynExpr ! {macro_error, Div} {
  let l := int_sum(e.sum)
  match e.opt {
    None => l
    Some(r) => {
      let b := int_sum(r.sum)
      match r.relation {
        EqOp(tok) => quote { Eq(Int, $l, $b) }
        LeOp(tok) => quote { Eq(Bool, Int::le($l, $b), true) }
        LtOp(tok) => quote { Eq(Bool, Int::lt($l, $b), true) }
      }
    }
  }
}
pub macro fn int(e: int_notation::Expr): SynExpr ! {macro_error, Div} { int_expression(e) }
// Compatibility name for existing users; the grammar now also accepts terms.
pub macro fn int_eq(e: int_notation::Expr): SynExpr ! {macro_error, Div} { int_expression(e) }
