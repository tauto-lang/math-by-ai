import std::Base
import std::Nat
import "notation.taut"
import "relations.taut"
import algebra::monoid
import "arithmetic.taut"
import "divisibility.taut"

pub theorem divides_sum(a: Nat, xs: List(Nat), h: AllDivisible(a, xs)): nat_rel!(`a | sum(xs)`) {
  ⊢ nat_rel!(`a | sum(xs)`) from match h {
    AllNil => divides_zero(a)
    AllCons(x, rest, hx, hr) => divides_add(a, x, sum(rest), hx, divides_sum(a, rest, hr))
  }
}
// Every positive power of a number is a multiple of that number.
pub theorem divides_positive_power(a: Nat, n: Nat): nat_rel!(`a | power(Nat::mul, 1, a, Succ(n))`) {
  By(power(Nat::mul, 1, a, n), Nat::mul_comm(a, power(Nat::mul, 1, a, n)))
}
// The same divisor divides every natural linear combination of two multiples.
pub theorem divides_linear_combination(
  a: Nat,
  b: Nat,
  c: Nat,
  x: Nat,
  y: Nat,
  ab: nat_rel!(`a | b`),
  ac: nat_rel!(`a | c`)
): nat_rel!(`a | b * x + c * y`) {
  divides_add(
    a,
    nat!(`b * x`),
    nat!(`c * y`),
    divides_mul_right(a, b, x, ab),
    divides_mul_right(a, c, y, ac)
  )
}
