import std::Base
import std::Nat
import std::IntLaws
import std::NatNorm
import "notation.taut"

// A proof carries a witness. No quotient computation or Boolean decision is assumed.
pub(open) inductive Divides(a: Nat, b: Nat): Prop {
  By(k: Nat, equation: nat!(`a * k = b`)): Divides(a, b)
}
pub theorem divides_refl(a: Nat): Divides(a, a) { By(1, Nat::mul_one_right(a)) }
pub theorem one_divides(a: Nat): Divides(1, a) { By(a, Nat::mul_one_left(a)) }
pub theorem divides_zero(a: Nat): Divides(a, 0) { By(0, Nat::mul_zero_right(a)) }
pub theorem divides_trans(
  a: Nat,
  b: Nat,
  c: Nat,
  ab: Divides(a, b),
  bc: Divides(b, c)
): Divides(a, c) {
  match ab: Divides(a, c) {
    By(k, hk) => match bc: Divides(a, c) {
      By(l, hl) => By(
        nat!(`k * l`),
        calc nat!(`a * (k * l)`) {
          = nat!(`(a * k) * l`) from Eq::sym(Nat::mul_assoc(a, k, l))
          = nat!(`b * l`) from Eq::congr((x: Nat) => nat!(`x * l`), hk)
          = c from hl
        }
      )
    }
  }
}
pub theorem divides_add(
  a: Nat,
  b: Nat,
  c: Nat,
  ab: Divides(a, b),
  ac: Divides(a, c)
): Divides(a, nat!(`b + c`)) {
  match ab: Divides(a, nat!(`b + c`)) {
    By(k, hk) => match ac: Divides(a, nat!(`b + c`)) {
      By(l, hl) => By(
        nat!(`k + l`),
        calc nat!(`a * (k + l)`) {
          = nat!(`a * k + a * l`) from Nat::mul_add_distrib(a, k, l)
          = nat!(`b + a * l`) from Eq::congr((x: Nat) => nat!(`x + a * l`), hk)
          = nat!(`b + c`) from Eq::congr((x: Nat) => nat!(`b + x`), hl)
        }
      )
    }
  }
}
pub theorem divides_mul_right(
  a: Nat,
  b: Nat,
  c: Nat,
  ab: Divides(a, b)
): Divides(a, nat!(`b * c`)) {
  match ab: Divides(a, nat!(`b * c`)) {
    By(k, hk) => By(
      nat!(`k * c`),
      calc nat!(`a * (k * c)`) {
        = nat!(`(a * k) * c`) from Eq::sym(Nat::mul_assoc(a, k, c))
        = nat!(`b * c`) from Eq::congr((x: Nat) => nat!(`x * c`), hk)
      }
    )
  }
}
pub theorem divides_mul_left(a: Nat, b: Nat, c: Nat, ab: Divides(a, b)): Divides(a, nat!(`c * b`)) {
  match ab: Divides(a, nat!(`c * b`)) {
    By(k, hk) => By(
      nat!(`k * c`),
      calc nat!(`a * (k * c)`) {
        = nat!(`(a * k) * c`) from Eq::sym(Nat::mul_assoc(a, k, c))
        = nat!(`b * c`) from Eq::congr((x: Nat) => nat!(`x * c`), hk)
        = nat!(`c * b`) from Nat::mul_comm(b, c)
      }
    )
  }
}
pub theorem zero_divides_only_zero(b: Nat, h: Divides(0, b)): nat!(`b = 0`) {
  match h: nat!(`b = 0`) {
    By(k, hk) => calc b {
      = nat!(`0 * k`) from Eq::sym(hk)
      = nat!(`0`) from Nat::mul_zero_left(k)
    }
  }
}

pub(open) inductive AllDivisible(a: Nat): (List(Nat)) -> Prop {
  AllNil: AllDivisible(a, Nil)
  AllCons(
    x: Nat,
    xs: List(Nat),
    head: Divides(a, x),
    tail: AllDivisible(a, xs)
  ): AllDivisible(a, Cons(x, xs))
}

pub theorem divides_bound(a: Nat, b: Nat, h: Divides(a, Succ(b))): nat!(`a ≤ Succ(b)`) {
  match h: nat!(`a ≤ Succ(b)`) {
    By(k, hk) => match k: nat!(`a ≤ Succ(b)`) {
      Zero => False::elim(Nat::zero_ne_succ(b, Eq::trans(Eq::sym(Nat::mul_zero_right(a)), hk)))
      Succ(j) => Eq::subst(
        (x: Nat) => nat!(`a ≤ x`),
        hk,
        Eq::subst(
          (x: Nat) => nat!(`a ≤ x`),
          Eq::sym(Nat::mul_succ_right(a, j)),
          Nat::le_add_left(nat!(`a * j`), a)
        )
      )
    }
  }
}
pub theorem divides_antisym(a: Nat, b: Nat, ab: Divides(a, b), ba: Divides(b, a)): nat!(`a = b`) {
  match b: nat!(`a = b`) {
    Zero => zero_divides_only_zero(a, ba)
    Succ(k) => match a: nat!(`a = Succ(k)`) {
      Zero => False::elim(Nat::zero_ne_succ(k, Eq::sym(zero_divides_only_zero(Succ(k), ab))))
      Succ(j) => Nat::le_antisym(
        Succ(j),
        Succ(k),
        divides_bound(Succ(j), k, ab),
        divides_bound(Succ(k), j, ba)
      )
    }
  }
}
