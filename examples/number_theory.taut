import std::Base
import std::Nat
import std::Int
import std::IntLaws
import nat::notation
import nat::integer_notation
import nat::relations
import core::notation
import algebra::commutative
import nat::arithmetic
import nat::divisibility
import nat::euclid
import nat::bezout
import nat::coprime
import nat::primes
import nat::primality
import nat::prime_decision
import nat::factorization
import nat::unique_factorization
import nat::infinite_primes

theorem euclid_computes(): nat!(`gcd(48, 18) = 6`) { Refl }
theorem zero_zero(): nat!(`gcd(0, 0) = 0`) { Refl }
theorem zero_left(): nat!(`gcd(0, 13) = 13`) { Refl }
theorem nontrivial_coprime(): Coprime(35, 12) { Refl }
theorem computed_gcd_is_greatest(a: Nat, b: Nat): IsGcd(a, b, gcd(a, b)) { gcd_correct(a, b) }
theorem gcd_symmetric(a: Nat, b: Nat): nat!(`gcd(a, b) = gcd(b, a)`) { gcd_comm(a, b) }
theorem computed_bezout(
  a: Nat,
  b: Nat
): int!(
  `↑a * coefficient_a(bezout_coefficients(a, b)) + ↑b * coefficient_b(bezout_coefficients(a, b)) = ↑gcd(a, b)`
) {
  bezout_identity(a, b)
}
theorem bezout_nontrivial(): int!(
  `↑30 * ${coefficient_a(bezout_coefficients(30, 18))} + ↑18 * ${coefficient_b(bezout_coefficients(30, 18))} = ↑6`
) {
  bezout_identity(30, 18)
}
theorem prime_two(): Prime(2) { is_prime_sound(2, Refl) }
theorem prime_ninety_seven(): Prime(97) { is_prime_sound(97, Refl) }
theorem composite_ninety_one(): logic!(`is_prime(91) = false`) { Refl }
theorem not_prime_ninety_one(h: Prime(91)): False { is_prime_false(91, Refl, h) }
theorem prime_product_lemma(
  p: Nat,
  a: Nat,
  b: Nat,
  hp: Prime(p),
  h: nat_rel!(`p | a * b`)
): logic!(`Divides(p, a) ∨ Divides(p, b)`) { prime_divides_product(p, a, b, hp, h) }
theorem concrete_factorization(): logic!(`factorize(60) = Cons(5, Cons(3, Cons(2, Cons(2, Nil))))`) { Refl }
theorem factors_of_one(): logic!(`factorize(1) = Nil`) { Refl }
theorem factorization_for_every_positive(
  n: Nat,
  pos: nat!(`0 < n`)
): Factorization(n, factorize(n)) {
  factorize_correct(n, pos)
}
theorem factorization_is_unique(
  n: Nat,
  xs: List(Nat),
  ys: List(Nat),
  hx: Factorization(n, xs),
  hy: Factorization(n, ys)
): Permutation(Nat, xs, ys) {
  factorization_unique(n, xs, ys, hx, hy)
}
theorem any_prime_certificate_passes(
  n: Nat,
  hp: Prime(n)
): logic!(`is_prime(n) = true`) { is_prime_complete(n, hp) }

theorem primes_have_no_upper_bound(n: Nat): AbovePrime(n, prime_above(n)) { prime_above_correct(n) }
theorem prime_above_three(): nat!(`prime_above(3) = 7`) { Refl }
theorem prime_above_four(): nat!(`prime_above(4) = 5`) { Refl }
theorem factorial_five(): nat!(`factorial(5) = 120`) { Refl }
